{
  "name": "fantappero",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "pnpm install",
    "dev:web": "pnpm --filter @fantappero/web dev",
    "dev:mobile": "pnpm --filter @fantappero/mobile start",
    "dev:mobile:locale": "pnpm --filter @fantappero/mobile start:locale",
    "dev:mobile:dev": "pnpm --filter @fantappero/mobile start:dev",
    "dev:mobile:pilota": "pnpm --filter @fantappero/mobile start:pilota",
    "dev:mobile:prod": "pnpm --filter @fantappero/mobile start:prod",
    "build": "pnpm -r --filter \"./packages/**\" --filter @fantappero/web build",
    "build:packages": "pnpm -r --filter \"./packages/**\" build",
    "build:web": "pnpm --filter @fantappero/web build",
    "test": "pnpm -r --if-present test",
    "test:web": "pnpm --filter @fantappero/web test",
    "test:mobile": "pnpm --filter @fantappero/mobile test",
    "test:packages": "pnpm -r --filter \"./packages/**\" --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
