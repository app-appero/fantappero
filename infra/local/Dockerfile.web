# syntax=docker/dockerfile:1
# Web dev server (Vite) for local Compose stack.

FROM node:22-bookworm-slim

ENV PNPM_HOME="/pnpm" \
    PATH="/pnpm:$PATH" \
    PNPM_VERSION=9.15.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare "pnpm@${PNPM_VERSION}" --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/tsconfig.json apps/web/vite.config.ts apps/web/index.html apps/web/
COPY apps/mobile/package.json apps/mobile/tsconfig.json apps/mobile/
COPY apps/web/public apps/web/public
COPY apps/web/src apps/web/src
COPY packages/contracts/package.json packages/contracts/tsconfig.json packages/contracts/
COPY packages/contracts/src packages/contracts/src
COPY packages/ui/package.json packages/ui/tsconfig.json packages/ui/vitest.config.ts packages/ui/
COPY packages/ui/src packages/ui/src
COPY packages/api-client/package.json packages/api-client/tsconfig.json packages/api-client/
COPY packages/api-client/src packages/api-client/src

# Su Docker Desktop/Windows con backend WSL2, il primo `pnpm install` durante
# la build può creare symlink dei pacchetti workspace risolti come path
# assoluti verso il mount host usato da BuildKit per il context (es.
# `/mnt/host/c/...`), che non esiste più a runtime nell'immagine finale — il
# pacchetto risulta introvabile (Vite: "Failed to resolve import"). Un
# secondo `pnpm install` da solo non basta: se il lockfile risulta già
# soddisfatto pnpm salta il relink e il symlink assoluto rimane. `--force`
# obbliga pnpm a ricreare i symlink adesso che `/app` è la working directory
# reale dell'immagine, stavolta relativi e corretti.
RUN pnpm install && pnpm install --force

# Build di produzione pre-compilata nell'immagine, non ad ogni avvio del
# container: su Railway (dev/pilota) l'entrypoint (web-entrypoint.sh) sceglie
# da solo di servire questa cartella già pronta — veloce e leggero, niente da
# configurare nel pannello Railway. Lo sviluppo locale continua a usare il CMD
# di default (dev server live) e non la tocca; qui costa solo qualche secondo
# in più alla build dell'immagine.
#
# Le variabili VITE_* finiscono incorporate nel bundle in questo momento
# (sostituzione statica di Vite), non lette a runtime dal container: a
# differenza delle altre variabili d'ambiente del servizio, Docker isola la
# build dal resto per sicurezza e NON le passa qui da solo. Vanno dichiarate
# esplicitamente con ARG — Railway le riconosce per nome tra le variabili già
# impostate sul servizio e le passa in automatico alla build
# (https://docs.railway.com/guides/build-time-vs-runtime-secrets). Senza
# questo le variabili risultano vuote nel bundle compilato, e l'app va in
# crash al primo render (schermata "Qualcosa è andato storto").
ARG VITE_API_BASE_URL
ARG VITE_GOOGLE_CLIENT_ID
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
RUN pnpm --filter @fantappero/web build

COPY infra/local/web-entrypoint.sh /usr/local/bin/web-entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/web-entrypoint.sh \
    && chmod +x /usr/local/bin/web-entrypoint.sh

EXPOSE 5174

ENTRYPOINT ["/usr/local/bin/web-entrypoint.sh"]
CMD ["pnpm", "--filter", "@fantappero/web", "dev", "--", "--host", "0.0.0.0"]
