# Local development defaults only — never production secrets.
# Copy to infra/local/.env if you need overrides (gitignored).

API_FOOTBALL_KEY=67d90279902aa6aa55cefd2263089ab9
API_FOOTBALL_REQUESTS_PER_MINUTE=300
API_FOOTBALL_RATE_LIMIT_PAUSE_SECONDS=60

FANTAPPERO_ENV=development
LOG_LEVEL=INFO
ERROR_TRACKING_ENABLED=false

POSTGRES_USER=fantappero
POSTGRES_PASSWORD=fantappero_local_dev_only
POSTGRES_DB=fantappero
POSTGRES_PORT=5432

REDIS_PORT=6379

API_PORT=8001
WEB_PORT=5174
VITE_API_BASE_URL=http://127.0.0.1:8001

# In-compose service hostnames (used by api/worker containers)
DATABASE_URL=postgresql://fantappero:fantappero_local_dev_only@postgres:5432/fantappero
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Scheduler pre/live/post (EP04-06) — default off to avoid burning provider quota
SPORTS_SCHEDULER_ENABLED=false
# SPORTS_POLL_LIVE_INTERVAL_SECONDS=60
# SPORTS_POLL_PRE_INTERVAL_SECONDS=900
# SPORTS_POLL_POST_INTERVAL_SECONDS=600
# SPORTS_POLL_LATE_INTERVAL_SECONDS=3600

# Turni europei automatici (EP06-01) — non chiama il provider, solo DB
FANTASY_TURNS_AUTO_GENERATE_ENABLED=true
# FANTASY_TURNS_AUTO_GENERATE_INTERVAL_SECONDS=3600
# FANTASY_TURNS_HORIZON_DAYS=14

# Reminder scadenza formazione (EP09-02) — non chiama il provider, solo DB
NOTIFICATIONS_LINEUP_REMINDER_ENABLED=true
# NOTIFICATIONS_LINEUP_REMINDER_INTERVAL_SECONDS=900
# NOTIFICATIONS_LINEUP_REMINDER_WINDOW_HOURS=24

# Auth / JWT (local dev only)
JWT_SECRET_KEY=fantappero_local_jwt_dev_only_change_in_production
WEB_APP_BASE_URL=http://localhost:5174

# Bootstrap del primo operator (EP11-04a) — vedi docs/operations/admin_operator_bootstrap.md
# BOOTSTRAP_OPERATOR_EMAIL=

# SMTP (Mailpit in local stack)
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=noreply@fantappero.local
MAIL_FROM_NAME=FantApperò

# Profile / avatar (EP02-02)
AVATAR_STORAGE_PATH=/data/avatars
AVATAR_MAX_BYTES=2097152
PROFILE_POLICY_VERSION=2026-01

# Optional tools profile (make up-tools)
ADMINER_PORT=8081
REDIS_COMMANDER_PORT=8082
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
