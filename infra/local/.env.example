# Local development defaults only — never production secrets.
# Copy to infra/local/.env if you need overrides (gitignored).

FANTAPPERO_ENV=development
LOG_LEVEL=INFO
ERROR_TRACKING_ENABLED=false

POSTGRES_USER=fantappero
POSTGRES_PASSWORD=fantappero_local_dev_only
POSTGRES_DB=fantappero
POSTGRES_PORT=5432

REDIS_PORT=6379

API_PORT=8000

# In-compose service hostnames (used by api/worker containers)
DATABASE_URL=postgresql://fantappero:fantappero_local_dev_only@postgres:5432/fantappero
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Optional tools profile (make up-tools)
ADMINER_PORT=8081
REDIS_COMMANDER_PORT=8082
