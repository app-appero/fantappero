{
  "name": "@fantappero/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "prestart": "pnpm --filter @fantappero/contracts build && pnpm --filter @fantappero/ui build && pnpm --filter @fantappero/api-client build",
    "start": "expo start --lan -c",
    "start:locale": "pnpm run prestart && node ./scripts/start-with-env.mjs locale",
    "start:dev": "pnpm run prestart && node ./scripts/start-with-env.mjs dev",
    "start:pilota": "pnpm run prestart && node ./scripts/start-with-env.mjs pilota",
    "start:prod": "pnpm run prestart && node ./scripts/start-with-env.mjs prod",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "tsc --noEmit --pretty false",
    "test": "node --test --experimental-strip-types src/health.test.ts src/config/env.test.ts src/navigation/navConfig.test.ts src/navigation/pendingInviteEvents.test.ts src/wireframes/useWireframeState.test.ts src/wireframes/screenMap.test.ts src/screens/ProfileScreen.test.ts src/screens/inviteDemo.test.ts src/screens/directoryDemo.test.ts src/leagues/leagueDeleteHelpers.test.ts src/api/fantasyTeams.test.ts src/auth/googleAppHandoff.test.ts src/screens/roster/listoneFilter.test.ts src/navigation/notificationDestination.test.ts src/session/accessTokenExpiry.test.ts scripts/start-with-env.test.mjs",
    "build": "expo export --platform ios --platform android",
    "build:android:locale": "pnpm run prestart && node ./scripts/build-with-env.mjs locale",
    "build:android:dev": "pnpm run prestart && node ./scripts/build-with-env.mjs dev",
    "build:android:pilota": "pnpm run prestart && node ./scripts/build-with-env.mjs pilota",
    "build:android:prod": "pnpm run prestart && node ./scripts/build-with-env.mjs prod"
  },
  "dependencies": {
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "15.1.1",
    "@fantappero/api-client": "workspace:*",
    "@fantappero/contracts": "workspace:*",
    "@fantappero/ui": "workspace:*",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/core": "^7.12.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "expo": "~57.0.26",
    "expo-auth-session": "~57.0.13",
    "expo-constants": "~57.0.22",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.4",
    "expo-notifications": "~57.0.23",
    "expo-image-picker": "^57.0.20",
    "expo-linking": "~57.0.11",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.0",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@expo/ngrok": "4.1.0",
    "@types/react": "~19.2.18",
    "typescript": "6.0.3"
  }
}
