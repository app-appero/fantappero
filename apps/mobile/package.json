{
  "name": "@fantappero/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "prestart": "pnpm --filter @fantappero/contracts build && pnpm --filter @fantappero/ui build && pnpm --filter @fantappero/api-client build",
    "start": "expo start --lan -c",
    "start:locale": "pnpm run prestart && node ./scripts/start-with-env.mjs locale",
    "start:dev": "pnpm run prestart && node ./scripts/start-with-env.mjs dev",
    "start:pilota": "pnpm run prestart && node ./scripts/start-with-env.mjs pilota",
    "start:prod": "pnpm run prestart && node ./scripts/start-with-env.mjs prod",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "tsc --noEmit --pretty false",
    "test": "node --test --experimental-strip-types src/health.test.ts src/config/env.test.ts src/navigation/navConfig.test.ts src/navigation/pendingInviteEvents.test.ts src/wireframes/useWireframeState.test.ts src/wireframes/screenMap.test.ts src/screens/ProfileScreen.test.ts src/screens/inviteDemo.test.ts src/screens/directoryDemo.test.ts src/leagues/leagueDeleteHelpers.test.ts src/api/fantasyTeams.test.ts src/auth/googleAppHandoff.test.ts src/screens/roster/listoneFilter.test.ts src/navigation/notificationDestination.test.ts src/navigation/notificationKind.test.ts src/session/accessTokenExpiry.test.ts scripts/start-with-env.test.mjs",
    "build": "expo export --platform ios --platform android",
    "build:android:locale": "pnpm run prestart && node ./scripts/build-with-env.mjs locale",
    "build:android:dev": "pnpm run prestart && node ./scripts/build-with-env.mjs dev",
    "build:android:pilota": "pnpm run prestart && node ./scripts/build-with-env.mjs pilota",
    "build:android:prod": "pnpm run prestart && node ./scripts/build-with-env.mjs prod"
  },
  "dependencies": {
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "15.1.1",
    "@fantappero/api-client": "workspace:*",
    "@fantappero/contracts": "workspace:*",
    "@fantappero/ui": "workspace:*",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/core": "^7.12.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "expo": "^58.0.21",
    "expo-auth-session": "~58.0.16",
    "expo-constants": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@expo/ngrok": "4.1.0",
    "@types/react": "~19.3.0",
    "typescript": "6.0.3"
  }
}
