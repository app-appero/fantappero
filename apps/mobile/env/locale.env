# API sul computer di sviluppo (porta 8001).
# Emulatore e Expo web sulla stessa macchina usano questo indirizzo.
# Telefono sulla stessa Wi-Fi: in apps/mobile/.env.local sovrascrivi con
# EXPO_PUBLIC_API_BASE_URL=http://<IP-LAN-del-PC>:8001
# (127.0.0.1 sul telefono è il telefono, non il PC). Vale solo per start:locale.

EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8001
