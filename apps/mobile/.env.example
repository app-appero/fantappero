# Mobile client — copy to apps/mobile/.env (gitignored)
# Template: config/settings/mobile.env.example
#
# Per scegliere l'API senza editare questo file, dalla root del repo:
#   pnpm dev:mobile:locale   API sul PC (127.0.0.1:8001)
#   pnpm dev:mobile:dev      https://fantappero-api-dev.up.railway.app
#   pnpm dev:mobile:pilota   https://api-pilota.up.railway.app
#   pnpm dev:mobile:prod     quando esisterà l'URL in apps/mobile/env/prod.env
#
# Emulator / Expo web sulla stessa macchina: http://127.0.0.1:8001
# Device fisico verso l'API locale: apps/mobile/.env.local con l'IP LAN del PC.
# (127.0.0.1 sul telefono punta al telefono stesso, non al PC)

EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8001

# Google OAuth (Google Cloud Console). Lascia vuote per nascondere
# "Continua con Google" — email/password resta comunque funzionante.
# Il client "Web" serve anche per il flusso Android via Expo AuthSession.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
