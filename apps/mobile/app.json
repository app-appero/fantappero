{
  "expo": {
    "name": "FantApperò",
    "slug": "fantappero",
    "scheme": "fantappero",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fantappero.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Consenti l'accesso alle foto per impostare l'avatar del profilo."
      }
    },
    "android": {
      "package": "com.fantappero.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-background.png",
        "backgroundColor": "#2748D8"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withGameCategory.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "Consenti l'accesso alle foto per impostare l'avatar del profilo."
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#2748D8"
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "extra": {
      "eas": {
        "projectId": "5134538d-7b9a-4f8a-98a8-0d801636040b"
      }
    },
    "owner": "romy92"
  }
}
