# Web client (Vite) — copy to apps/web/.env
# Only EXPO_PUBLIC_* / VITE_* vars are exposed to the browser bundle.

VITE_API_BASE_URL=http://127.0.0.1:8001

# Google OAuth Web Client ID (Google Cloud Console). Leave empty to hide
# "Continua con Google" — email/password keeps working either way.
VITE_GOOGLE_CLIENT_ID=
