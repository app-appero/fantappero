# API process — copy into repo root `.env` (see ../../.env.example)

FANTAPPERO_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql://fantappero:fantappero_local_dev_only@127.0.0.1:5432/fantappero
REDIS_URL=redis://127.0.0.1:6379/0

# Provider secrets — backend only, never in apps/*
API_FOOTBALL_KEY=
