# API process — copy into repo root `.env` (see ../../.env.example)

FANTAPPERO_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql://fantappero:fantappero_local_dev_only@127.0.0.1:5432/fantappero
REDIS_URL=redis://127.0.0.1:6379/0

JWT_SECRET_KEY=fantappero_local_jwt_dev_only_change_in_production
WEB_APP_BASE_URL=http://localhost:5174
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=noreply@fantappero.local

# Provider secrets — backend only, never in apps/*
API_FOOTBALL_KEY=
