# Copy to .env and fill in. Never commit .env.
# Per-component templates: config/settings/
# Operations guide: docs/operations/configuration_and_secrets.md

# Runtime profile: development | test | staging | production
# Use "test" only for automated tests (relaxed infra requirements).
FANTAPPERO_ENV=development
LOG_LEVEL=INFO

# Observability (EP01-05) — error tracking behind interface; keep disabled locally
ERROR_TRACKING_ENABLED=false
# ERROR_TRACKING_DSN=

# Provider secrets (backend only — never in apps/*)
API_FOOTBALL_KEY=
# Optional adapter tuning (EP04-01)
# API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# API_FOOTBALL_TIMEOUT_SECONDS=30
# API_FOOTBALL_MAX_RETRIES=3
# API_FOOTBALL_RETRY_BACKOFF_SECONDS=1
# Piano Pro = 300 req/min (throttle + pausa automatica)
# API_FOOTBALL_REQUESTS_PER_MINUTE=300
# API_FOOTBALL_RATE_LIMIT_PAUSE_SECONDS=60

# Scheduler pre/live/post (EP04-06) — default off in locale per non consumare quota
# SPORTS_SCHEDULER_ENABLED=false
# SPORTS_POLL_LIVE_INTERVAL_SECONDS=60
# SPORTS_POLL_PRE_INTERVAL_SECONDS=900
# SPORTS_POLL_POST_INTERVAL_SECONDS=600
# SPORTS_POLL_LATE_INTERVAL_SECONDS=3600

# Host-run API against Compose postgres/redis (EP01-02).
# Inside containers, compose uses hostnames postgres/redis instead of 127.0.0.1.
DATABASE_URL=postgresql://fantappero:fantappero_local_dev_only@127.0.0.1:5432/fantappero
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Auth / JWT (local dev only — change in production)
JWT_SECRET_KEY=fantappero_local_jwt_dev_only_change_in_production
WEB_APP_BASE_URL=http://localhost:5174

# SMTP (Mailpit when using docker compose local stack)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=noreply@fantappero.local
MAIL_FROM_NAME=FantApperò
